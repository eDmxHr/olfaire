{
  "expo": {
    "name": "Olfaire",
    "slug": "olfaire",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "scheme": "olfaire",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "fonts": [
      "./assets/fonts/CormorantGaramond-Light.ttf",
      "./assets/fonts/CormorantGaramond-LightItalic.ttf",
      "./assets/fonts/CormorantGaramond-Regular.ttf",
      "./assets/fonts/CormorantGaramond-Italic.ttf",
      "./assets/fonts/CormorantGaramond-Medium.ttf",
      "./assets/fonts/DMSans-Light.ttf",
      "./assets/fonts/DMSans-Regular.ttf",
      "./assets/fonts/DMSans-Medium.ttf"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olfaire.app"
    },
    "android": {
      "package": "com.olfaire.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      }
    }
  }
}
